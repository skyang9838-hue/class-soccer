{
  "name": "class-soccer",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "ClassRoom" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClassRoom", "Registry"] }]
}
